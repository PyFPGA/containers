FROM ubuntu:latest AS builder

WORKDIR /tmp

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq

RUN apt-get install -y --no-install-recommends \
    ca-certificates \
    git

#
# GHDL (https://github.com/ghdl/ghdl)
#

RUN apt-get install -y --no-install-recommends \
    build-essential \
    gnat \
    zlib1g-dev

RUN git clone --depth 1 https://github.com/ghdl/ghdl
RUN mkdir ghdl/build && cd ghdl/build && ../configure --prefix=/usr/local \
 && make -j$(nproc) && make install

#
# iVerilog (https://github.com/steveicarus/iverilog)
#

RUN apt-get install -y --no-install-recommends \
    autoconf \
    bison \
    build-essential \
    flex \
    gperf

RUN git clone --depth 1 https://github.com/steveicarus/iverilog
RUN cd iverilog && autoconf && ./configure \
 && make -j$(nproc) && make install

#
# Verilator (https://github.com/verilator/verilator)
#

RUN apt-get install -y --no-install-recommends \
    autoconf \
    bison \
    build-essential \
    flex \
    help2man \
    libfl-dev \
    python3

RUN git clone --depth 1 https://github.com/verilator/verilator
RUN cd verilator && autoconf && ./configure \
 && make -j$(nproc) && make install

#
# cocotb
#

RUN apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv

RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir \
    cocotb \
    cocotbext-axi \
    pytest \
    wavedrom

#
# Optimization and clean-up
#

RUN find /usr/local/bin /usr/local/lib -type f -not -path "*/python3*" \
    -exec strip --strip-unneeded {} + 2>/dev/null || true
RUN find /usr/local/lib -name "*.a" -delete \
 && rm -f /usr/local/bin/verilator_bin_dbg /usr/local/bin/verilator_coverage_bin_dbg \
 && rm -rf /usr/local/lib/cmake /usr/local/*/pkgconfig

#------------------------------------------------------------------------------

FROM ubuntu:latest AS runtime

ENV PATH="/opt/venv/bin:$PATH"

RUN apt-get update -qq \
    && GNAT=$(apt-cache depends gnat | sed -n 's/.*Depends: gnat-\([0-9]*\)$/\1/p') \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    g++ \
    make \
    perl \
    python3 \
    "libgnat-$GNAT" \
    zlib1g \
    && apt-get install -y --no-install-recommends \
    "libpython$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')" \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin   /usr/local/bin
COPY --from=builder /usr/local/lib   /usr/local/lib
COPY --from=builder /usr/local/share /usr/local/share
COPY --from=builder /opt/venv /opt/venv

RUN ldconfig
