# https://github.com/YosysHQ/prjtrellis
# https://github.com/YosysHQ/nextpnr

FROM ubuntu:latest AS builder

WORKDIR /tmp

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq
RUN apt-get install -y --no-install-recommends \
    ca-certificates \
    git
RUN apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libboost-dev \
    libboost-filesystem-dev \
    libboost-iostreams-dev \
    libboost-program-options-dev \
    libboost-thread-dev \
    libeigen3-dev \
    openocd \
    python3-dev

#
# Trellis
#

RUN git clone --depth 1 --recursive https://github.com/YosysHQ/prjtrellis
RUN cd prjtrellis/libtrellis && cmake -DCMAKE_INSTALL_PREFIX=/usr/local . \
 && make -j$(nproc) && make install

#
# NextPNR
#

RUN git clone --depth 1 https://github.com/YosysHQ/nextpnr
RUN cd nextpnr && git submodule update --init --recursive \
 && mkdir -p build && cd build \
 && cmake .. -DARCH=ecp5 -DTRELLIS_INSTALL_PREFIX=/usr/local \
 && make -j$(nproc) && make install

#
# Optimization and clean-up
#

RUN find /usr/local/bin /usr/local/lib -type f -not -path "*/python3*" \
    -exec strip --strip-unneeded {} + 2>/dev/null || true
RUN find /usr/local/lib -name "*.a" -delete \
 && rm -rf /usr/local/lib/cmake /usr/local/*/pkgconfig

#------------------------------------------------------------------------------

FROM ubuntu:latest AS runtime

RUN apt-get update -qq \
    && BOOST=$(apt-cache depends libboost-dev | sed -n 's/.*Depends: libboost\([0-9.]*\)-dev$/\1/p') \
    && PYTHON=$(apt-cache depends python3 | sed -n 's/.*Depends: python\(3\.[0-9]*\)$/\1/p') \
    && apt-get install -y --no-install-recommends \
    "libboost-filesystem$BOOST.0" \
    "libboost-program-options$BOOST.0" \
    "libboost-thread$BOOST.0" \
    "libpython$PYTHON" \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin   /usr/local/bin
COPY --from=builder /usr/local/lib   /usr/local/lib
COPY --from=builder /usr/local/share /usr/local/share

RUN ldconfig
