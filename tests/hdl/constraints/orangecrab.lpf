# OrangeCrab r0.2 (LFE5U-25F-CSFBGA285): clock, user button, RGB LED and gpio_0
LOCATE COMP "clk" SITE "A9";
IOBUF PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 48.0 MHz;
LOCATE COMP "rst" SITE "J17";
IOBUF PORT "rst" IO_TYPE=SSTL135_I;
LOCATE COMP "count[0]" SITE "K4";
LOCATE COMP "count[1]" SITE "M3";
LOCATE COMP "count[2]" SITE "J3";
LOCATE COMP "count[3]" SITE "N17";
IOBUF PORT "count[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "count[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "count[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "count[3]" IO_TYPE=LVCMOS33;
